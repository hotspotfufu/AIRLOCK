; Engine configuration file.
; AIRLOCK — target engine: Godot 4.7.x (Compatibility renderer: required for
; browser/itch.io builds, and runs on weaker PCs).
; Input actions are registered in code by core/input_setup.gd so they live in
; one readable file instead of serialized InputEvent blobs here.

config_version=5

[application]

config/name="AIRLOCK"
config/description="Cooperative sci-fi survival horror for four players."
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://core/input_setup.gd"
NetworkManager="*res://multiplayer/network_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="own_body_hidden"
3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="alien"
3d_physics/layer_4="interactables"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
